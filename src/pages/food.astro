---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    id: 'twitchcon-vip',
    title: 'TwitchCon VIP Experience',
    category: 'Event Culinary',
    description: 'Curated VIP dining experience for TwitchCon, blending elevated Asian comfort food with large-scale event execution. Designed and executed multi-course menus for hundreds of guests including talent, creators, and brand partners.',
    tags: ['Large-Scale Events', 'VIP Service', 'Brand Partnerships'],
    gradient: 'from-purple-900/80 to-indigo-900/80',
    accent: 'from-purple-500/30 to-indigo-600/30',
    stat: { value: '500+', label: 'VIP Covers' },
  },
  {
    id: 'hexclad-dine-la',
    title: 'HexClad × Riviera DINE LA',
    category: 'Brand Collaboration',
    description: 'Partnership dinner series with HexClad at Riviera for DINE LA, showcasing premium cookware through an elevated tasting menu. Bridged culinary artistry with brand storytelling in an intimate, multi-course format.',
    tags: ['Brand Activation', 'Tasting Menu', 'Cookware Partnership'],
    gradient: 'from-amber-900/80 to-orange-900/80',
    accent: 'from-amber-500/30 to-orange-600/30',
    stat: { value: 'DINE LA', label: 'Featured Event' },
  },
  {
    id: 'fortnite-super-bowl',
    title: 'Fortnite Super Bowl Activation',
    category: 'Corporate & Gaming',
    description: 'High-profile Super Bowl activation for Epic Games / Fortnite, delivering hospitality-grade food service at the intersection of gaming culture and major sporting events. Executed in a fast-paced, high-visibility environment.',
    tags: ['Super Bowl', 'Gaming Industry', 'Live Activation'],
    gradient: 'from-blue-900/80 to-cyan-900/80',
    accent: 'from-blue-500/30 to-cyan-600/30',
    stat: { value: 'Super Bowl', label: 'Main Event' },
  },
  {
    id: 'qrff-thanksgiving',
    title: 'QRFF Thanksgiving — 1,200 Guests',
    category: 'Large-Scale Operations',
    description: 'Led end-to-end culinary operations for the Queens Restaurant Festival Foundation\'s Thanksgiving event, serving 1,200 guests. Coordinated multi-team kitchen logistics, procurement, and plated service at this scale.',
    tags: ['1,200 Covers', 'Nonprofit', 'Logistics Leadership'],
    gradient: 'from-orange-900/80 to-red-900/80',
    accent: 'from-orange-500/30 to-red-600/30',
    stat: { value: '1,200', label: 'Guests Served' },
  },
  {
    id: 'rosalynn-supper-club',
    title: 'Rosalynn Supper Club — Staff Training',
    category: 'Culinary Training',
    description: 'Designed and delivered comprehensive kitchen and service training program for Rosalynn Supper Club. Built standard operating procedures, recipe documentation, and FOH/BOH coordination playbooks to elevate team performance and consistency.',
    tags: ['Team Training', 'SOPs', 'Supper Club'],
    gradient: 'from-rose-900/80 to-pink-900/80',
    accent: 'from-rose-500/30 to-pink-600/30',
    stat: { value: 'Full Team', label: 'Trained' },
  },
];
---

<BaseLayout
  title="F&B Portfolio — Jimmy Lau Choy"
  description="Elevated culinary portfolio: large-scale event execution, brand activations, and consulting across gaming, luxury, and nonprofit sectors."
>
  <!-- Hero Section -->
  <section class="relative min-h-[60vh] flex items-center justify-center overflow-hidden bg-primary-900">
    <div class="absolute inset-0 bg-gradient-to-br from-primary-900 via-primary-800 to-accent-900/40"></div>
    <!-- Texture overlay -->
    <div class="absolute inset-0 opacity-5" style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>

    <div class="container-custom relative z-10 text-center py-20">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 border border-white/20 text-white/80 text-sm font-medium mb-6">
        <span class="w-2 h-2 rounded-full bg-accent-400 inline-block"></span>
        Elevated Asian Comfort · Michelin-Trained · Large-Scale Ops
      </div>
      <h1 class="text-5xl md:text-7xl font-display font-bold text-white mb-6">
        Food &amp; Beverage<br>
        <span class="text-gradient">Portfolio</span>
      </h1>
      <p class="text-xl md:text-2xl text-primary-300 mb-10 max-w-3xl mx-auto">
        From 1,200-person Thanksgiving dinners to Super Bowl brand activations — elevated culinary at every scale.
      </p>
      <div class="flex flex-wrap justify-center gap-6 text-center">
        <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-2xl px-6 py-4">
          <div class="text-3xl font-display font-bold text-white">5+</div>
          <div class="text-primary-400 text-sm mt-1">Major Events</div>
        </div>
        <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-2xl px-6 py-4">
          <div class="text-3xl font-display font-bold text-white">1,200+</div>
          <div class="text-primary-400 text-sm mt-1">Covers at Scale</div>
        </div>
        <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-2xl px-6 py-4">
          <div class="text-3xl font-display font-bold text-white">Fortune 500</div>
          <div class="text-primary-400 text-sm mt-1">Brand Partners</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Philosophy Strip -->
  <section class="py-10 bg-accent-600">
    <div class="container-custom">
      <p class="text-center text-white font-display text-lg md:text-xl italic">
        "Elevated Asian comfort for the tired rich — Michelin training meets engineering precision."
      </p>
    </div>
  </section>

  <!-- Portfolio Projects -->
  <section class="section-padding bg-primary-900">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-display font-bold text-white mb-4">
          Selected <span class="text-gradient">Work</span>
        </h2>
        <p class="text-xl text-primary-400 max-w-2xl mx-auto">
          A track record across gaming culture, luxury brand activations, nonprofit galas, and private dining.
        </p>
      </div>

      <div class="space-y-8">
        {projects.map((project, index) => (
          <article class={`group relative overflow-hidden rounded-3xl bg-gradient-to-br ${project.gradient} border border-white/10 hover:border-white/20 transition-all duration-500 hover:shadow-2xl hover:shadow-black/40`}>
            <div class={`absolute inset-0 bg-gradient-to-br ${project.accent} opacity-0 group-hover:opacity-100 transition-opacity duration-500`}></div>

            <div class="relative z-10 p-8 md:p-12">
              <div class="flex flex-col md:flex-row md:items-start gap-8">
                <!-- Left: Index + Stat -->
                <div class="flex-none flex flex-row md:flex-col items-center md:items-start gap-6 md:gap-4 md:w-28">
                  <span class="text-6xl md:text-7xl font-display font-bold text-white/10 leading-none select-none">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <div class="md:mt-auto">
                    <div class="text-2xl font-display font-bold text-white">{project.stat.value}</div>
                    <div class="text-primary-400 text-xs uppercase tracking-wider">{project.stat.label}</div>
                  </div>
                </div>

                <!-- Divider -->
                <div class="hidden md:block w-px bg-white/10 self-stretch"></div>

                <!-- Right: Content -->
                <div class="flex-1">
                  <div class="flex flex-wrap items-center gap-3 mb-4">
                    <span class="text-xs font-medium text-accent-400 uppercase tracking-widest">{project.category}</span>
                  </div>
                  <h3 class="text-2xl md:text-3xl font-display font-bold text-white mb-4 group-hover:text-accent-200 transition-colors duration-300">
                    {project.title}
                  </h3>
                  <p class="text-primary-300 text-base md:text-lg leading-relaxed mb-6">
                    {project.description}
                  </p>
                  <div class="flex flex-wrap gap-2">
                    {project.tags.map(tag => (
                      <span class="px-3 py-1 text-xs font-medium text-primary-300 border border-white/15 rounded-full bg-white/5">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="section-padding bg-primary-800">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-display font-bold text-white mb-4">
          F&amp;B <span class="text-gradient">Consulting</span>
        </h2>
        <p class="text-xl text-primary-400 max-w-2xl mx-auto">
          Bringing Michelin-trained precision and engineering operations thinking to your food program.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white/5 border border-white/10 rounded-2xl p-8 hover:bg-white/10 hover:border-white/20 transition-all duration-300">
          <div class="w-12 h-12 bg-accent-600/30 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-display font-semibold text-white mb-3">Event & Activation</h3>
          <p class="text-primary-400 text-sm leading-relaxed">Large-scale event culinary operations, brand activations, VIP dining programs, and hospitality-grade execution for 100–5,000+ guests.</p>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-8 hover:bg-white/10 hover:border-white/20 transition-all duration-300">
          <div class="w-12 h-12 bg-accent-600/30 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-display font-semibold text-white mb-3">Menu Development</h3>
          <p class="text-primary-400 text-sm leading-relaxed">Remote menu consulting for restaurant groups, CPG brands, and private dining concepts. Elevated Asian comfort meets modern technique.</p>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-8 hover:bg-white/10 hover:border-white/20 transition-all duration-300">
          <div class="w-12 h-12 bg-accent-600/30 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
            </svg>
          </div>
          <h3 class="text-xl font-display font-semibold text-white mb-3">Training & SOPs</h3>
          <p class="text-primary-400 text-sm leading-relaxed">Kitchen team training programs, standard operating procedures, and FOH/BOH coordination systems to build consistent, scalable operations.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section-padding bg-primary-900 text-white border-t border-white/10">
    <div class="container-custom text-center">
      <h2 class="text-4xl md:text-5xl font-display font-bold mb-6">
        Let's Build Something <span class="text-gradient">Remarkable</span>
      </h2>
      <p class="text-xl text-primary-400 mb-10 max-w-2xl mx-auto">
        Available for brand activations, private chef engagements, menu consulting, and large-scale event culinary direction.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 text-base font-medium text-primary-900 bg-white rounded-full hover:bg-primary-50 transition-colors">
          Start a Conversation
        </a>
        <a href="/work" class="inline-flex items-center justify-center px-8 py-4 text-base font-medium text-white border-2 border-white/30 rounded-full hover:border-white hover:bg-white/10 transition-colors">
          View All Work
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
